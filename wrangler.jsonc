{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-agent",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "CONVERSATION_KV",
      "id": "45a31056d43e45f5aa02650d8fa5c6c8"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}